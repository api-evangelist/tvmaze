            {
              "name": "Mark Episodes Within a Show as Acquired or Watched Based on Their Attributes",
              "id": "96a1389f-9e4d-4d3c-b341-7c9faa588071",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "[\n  {\n    \"airdate\": \"<date>\",\n    \"episode\": \"<integer>\",\n    \"marked_at\": \"<integer>\",\n    \"season\": \"<integer>\",\n    \"type\": {\n      \"description\": \"0 for watched, 1 for acquired, 2 for skipped\"\n    }\n  },\n  {\n    \"airdate\": \"<date>\",\n    \"episode\": \"<integer>\",\n    \"marked_at\": \"<integer>\",\n    \"season\": \"<integer>\",\n    \"type\": {\n      \"description\": \"0 for watched, 1 for acquired, 2 for skipped\"\n    }\n  }\n]",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/scrobble/shows?tvmaze_id=<integer>&thetvdb_id=<integer>&imdb_id=<integer>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "scrobble",
                    "shows"
                  ],
                  "query": [
                    {
                      "description": "The show's TVmaze ID",
                      "key": "tvmaze_id",
                      "value": "<integer>"
                    },
                    {
                      "description": "The show's TheTVDB ID",
                      "key": "thetvdb_id",
                      "value": "<integer>"
                    },
                    {
                      "description": "The show's IMDB ID",
                      "key": "imdb_id",
                      "value": "<integer>"
                    }
                  ]
                },
                "description": "To specify a show, supply either `tvmaze_id`, `thetvdb_id` or `imdb_id`. To specify an episode, supply either both `season` and `episode`, or `airdate`.\n\nThis endpoint can be used by all users, even without premium.\n"
              },
