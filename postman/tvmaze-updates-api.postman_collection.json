                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/updates/shows?since=week",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "updates",
                    "shows"
                  ],
                  "query": [
                    {
                      "key": "since",
                      "value": "week"
