{
  "info": {
    "_postman_id": "94ca5f1c-e550-4536-bbe3-8d65f3dfd8ef",
    "name": "TVmaze Premium User auth API",
    "description": "Premium-only user API for TVmaze. Access is restricted to users with a paid\n[Premium subscription](https://www.tvmaze.com/premium). A user can only access\ntheir own data.\n\nAuthentication uses HTTP Basic: the TVmaze username is the basic-auth username and\nthe API key (visible on the user dashboard) is the basic-auth password. There is\nalso a device-style auth-pairing flow exposed at `/auth/start` and `/auth/poll`.\n\n\nContact Support:\n Name: TVmaze",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:20:49.000Z",
    "updatedAt": "2026-07-28T03:20:49.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-94ca5f1c-e550-4536-bbe3-8d65f3dfd8ef"
  },
