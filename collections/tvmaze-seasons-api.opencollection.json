{
  "opencollection": "1.0.0",
  "info": {
    "name": "TVmaze Premium User auth Seasons API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Seasons",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Season",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tvmaze.com/v1/seasons/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return a single season."
        },
        {
          "info": {
            "name": "Get Season Episodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tvmaze.com/v1/seasons/:id/episodes",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return the episodes of a season."
        }
      ]
    }
  ],
  "bundled": true
}